<Page
    x:Class="CodexTweaks.Windows.Pages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer
        x:Name="PackagesScrollViewer"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Visible"
        VerticalScrollMode="Enabled">
        <Grid
            x:Name="PageContent"
            Width="{Binding ViewportWidth, ElementName=PackagesScrollViewer, Mode=OneWay}"
            MaxWidth="{StaticResource CodexContentMaxWidth}"
            Padding="{StaticResource CodexPagePaddingThickness}"
            HorizontalAlignment="Center"
            RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Style="{StaticResource CodexPageHeaderStyle}">
            <TextBlock x:Name="PageTitle" Style="{StaticResource CodexPageTitleTextStyle}" />
            <TextBlock x:Name="PageSubtitle" Style="{StaticResource CodexPageSubtitleTextStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Library" Style="{StaticResource CodexSmallIconStyle}" />
                    <TextBlock
                        x:Name="PackageSummary"
                        Style="{StaticResource CodexBodyTextStyle}"
                        FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="DeveloperModeTitle"
                            VerticalAlignment="Center"
                            Style="{StaticResource CodexBodyTextStyle}"
                            FontWeight="SemiBold" />
                        <ToggleSwitch
                            x:Name="DeveloperModeToggle"
                            Width="44"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="DeveloperModeToggle_Toggled" />
                    </StackPanel>
                    <Button
                        x:Name="RescanButton"
                        Click="RescanButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Refresh" Style="{StaticResource CodexSmallIconStyle}" />
                            <TextBlock x:Name="RescanButtonText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock
                x:Name="DeveloperModeDetail"
                Style="{StaticResource CodexCaptionTextStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <Grid MinHeight="30" ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <SymbolIcon
                    x:Name="NodeStatusIcon"
                    VerticalAlignment="Center"
                    Style="{StaticResource CodexSmallIconStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="NodeStatusText" Style="{StaticResource CodexBodyTextStyle}" />
                    <TextBlock
                        x:Name="NodePathText"
                        Style="{StaticResource CodexMonospaceTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <Grid MinHeight="34" ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <SymbolIcon
                    x:Name="GitStatusIcon"
                    VerticalAlignment="Center"
                    Style="{StaticResource CodexSmallIconStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="GitStatusText" Style="{StaticResource CodexBodyTextStyle}" />
                    <TextBlock
                        x:Name="GitPathText"
                        Style="{StaticResource CodexMonospaceTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <Button x:Name="LocalInstallButton">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="ChooseZipMenuItem" Click="ChooseZipMenuItem_Click" />
                            <MenuFlyoutItem x:Name="ChooseDirectoryMenuItem" Click="ChooseDirectoryMenuItem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Add" Style="{StaticResource CodexSmallIconStyle}" />
                        <TextBlock x:Name="LocalInstallButtonText" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoteInstallButton" Click="RemoteInstallButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Download" Style="{StaticResource CodexSmallIconStyle}" />
                        <TextBlock x:Name="RemoteInstallButtonText" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoteUpdatesButton" Click="RemoteUpdatesButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Sync" Style="{StaticResource CodexSmallIconStyle}" />
                        <TextBlock x:Name="RemoteUpdatesButtonText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="6">
            <InfoBar x:Name="LocalFeedback" IsClosable="False" IsOpen="False" />
            <InfoBar x:Name="RemoteFeedback" IsClosable="False" IsOpen="False" />
        </StackPanel>

        <Grid Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="LoadOrderTitle"
                    Style="{StaticResource CodexBodyTextStyle}"
                    FontWeight="SemiBold" />
                <TextBlock x:Name="LoadOrderDetail" Style="{StaticResource CodexCaptionTextStyle}" />
            </StackPanel>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />
            <ComboBox
                x:Name="FilterComboBox"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                SelectionChanged="FilterComboBox_SelectionChanged" />
            <Button
                x:Name="ClearFilterButton"
                Grid.Column="3"
                Click="ClearFilterButton_Click"
                Style="{StaticResource CodexIconButtonStyle}">
                <SymbolIcon Symbol="Clear" Style="{StaticResource CodexSmallIconStyle}" />
            </Button>
        </Grid>

        <Grid Grid.Row="5">
            <ItemsRepeater x:Name="PackagesList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="2" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Padding="8,9" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ToggleSwitch
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Top"
                                    DataContext="{Binding}"
                                    IsEnabled="{Binding CanSetEnabled}"
                                    IsOn="{Binding IsEnabled, Mode=OneWay}"
                                    Toggled="PackageToggle_Toggled" />

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontFamily="{StaticResource CodexDisplayFontFamily}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CodexCaptionTextStyle}"
                                            Text="{Binding VersionText}" />
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CodexBodyTextStyle}"
                                        Text="{Binding Detail}" />
                                    <TextBlock
                                        Foreground="{Binding StatusBrush}"
                                        Style="{StaticResource CodexCaptionTextStyle}"
                                        Text="{Binding StatusDetail}"
                                        Visibility="{Binding StatusDetailVisibility}" />
                                    <Grid
                                        ColumnSpacing="7"
                                        Visibility="{Binding MessagesVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                        <SymbolIcon
                                            VerticalAlignment="Top"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Symbol="Important"
                                            Style="{StaticResource CodexSmallIconStyle}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Style="{StaticResource CodexCaptionTextStyle}"
                                            Text="{Binding MessagesText}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CodexCaptionTextStyle}"
                                            Text="{Binding PriorityLabel}" />
                                        <TextBox
                                            Width="58"
                                            Height="32"
                                            DataContext="{Binding}"
                                            IsEnabled="{Binding CanSetPriority}"
                                            KeyDown="PriorityTextBox_KeyDown"
                                            LostFocus="PriorityTextBox_LostFocus"
                                            Text="{Binding PriorityText, Mode=OneWay}" />
                                        <Button
                                            DataContext="{Binding}"
                                            Click="ResetPriorityButton_Click"
                                            Content="{Binding ResetPriorityLabel}"
                                            IsEnabled="{Binding CanSetPriority}"
                                            Visibility="{Binding ResetPriorityVisibility}" />
                                        <Border Style="{StaticResource CodexStatusPillStyle}">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding StatusBrush}"
                                                Text="{Binding StatusTitle}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            DataContext="{Binding}"
                                            Click="InstallDependenciesButton_Click"
                                            Content="{Binding InstallDependenciesLabel}"
                                            IsEnabled="{Binding CanInstallDependencies}"
                                            Visibility="{Binding InstallDependenciesVisibility}" />
                                        <Button
                                            DataContext="{Binding}"
                                            Click="EnableDependenciesButton_Click"
                                            Content="{Binding EnableDependenciesLabel}"
                                            IsEnabled="{Binding CanEnableDependencies}"
                                            Visibility="{Binding EnableDependenciesVisibility}" />
                                        <Button
                                            DataContext="{Binding}"
                                            Click="UpdatePackageButton_Click"
                                            Content="{Binding UpdateLabel}"
                                            IsEnabled="{Binding CanUpdate}"
                                            Visibility="{Binding UpdateVisibility}" />
                                        <Button
                                            AutomationProperties.Name="{Binding OpenDirectoryLabel}"
                                            DataContext="{Binding}"
                                            Click="OpenPackageDirectoryButton_Click"
                                            IsEnabled="{Binding CanOpenDirectory}"
                                            Style="{StaticResource CodexIconButtonStyle}"
                                            ToolTipService.ToolTip="{Binding OpenDirectoryLabel}">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="14"
                                                Glyph="&#xE8B7;" />
                                        </Button>
                                        <Button
                                            DataContext="{Binding}"
                                            Click="BuildPackageButton_Click"
                                            Content="{Binding BuildLabel}"
                                            IsEnabled="{Binding CanBuild}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource CodexDividerStyle}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel
                x:Name="EmptyState"
                MinHeight="240"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <SymbolIcon x:Name="EmptyStateIcon" Style="{StaticResource CodexEmptyStateIconStyle}" />
                <TextBlock
                    x:Name="EmptyStateTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CodexSectionTitleTextStyle}" />
                <TextBlock
                    x:Name="EmptyStateDetail"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Style="{StaticResource CodexPageSubtitleTextStyle}" />
                <Button
                    x:Name="EmptyStateButton"
                    HorizontalAlignment="Center"
                    Click="EmptyStateButton_Click" />
            </StackPanel>
        </Grid>
        </Grid>
    </ScrollViewer>
</Page>
